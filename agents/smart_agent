# agents/smart_agent.py
import random
from collections import Counter
from agents.base import Agent, Action
from game.rules import RESOURCES, COST_ROAD, COST_SETTLEMENT, COST_CITY


class SmartAgent(Agent):
    """
    Agent intelligent pour Catan :
    - Priorise les villes (gain +1 point immédiat)
    - Villages sur les meilleurs spots (numéros chauds + diversité)
    - Routes pour ouvrir des spots à fort potentiel ou bloquer
    - Voleur : cible les leaders ou les joueurs riches
    - Trades banque : seulement quand excès clair et besoin réel
    - Trades joueurs : rares et seulement très avantageux
    """

    def __init__(self):
        super().__init__()
        # Petite mémoire pour éviter de toujours upgrader le même settlement
        self.last_upgraded_vertex = None

    def choose_action(self, game, pid):
        player = game.players[pid]
        board = game.board

        # 1. Priorité absolue : voleur si c'est le tour du voleur
        if hasattr(game, 'robber_turn') and game.robber_turn:
            return self._choose_robber_move(game, pid)

        # 2. Construire une ville si possible (gain +1 point immédiat)
        own_settlements = [
            v for v, (p, t) in board.buildings.items()
            if p == pid and t == 'settlement' and v != self.last_upgraded_vertex
        ]
        if player.can_build_city() and own_settlements:
            # Choisit le settlement le plus rentable
            best_v = max(
                own_settlements,
                key=lambda v: self._vertex_value(board, v),
                default=random.choice(own_settlements)
            )
            self.last_upgraded_vertex = best_v
            return Action('build_city', best_v)

        # 3. Nouveau village sur le meilleur spot disponible
        free_vertices = [v for v in board.get_all_vertices() if v not in board.buildings]
        if player.can_build_settlement() and free_vertices:
            best_v = max(
                free_vertices,
                key=lambda v: self._vertex_value(board, v),
                default=random.choice(free_vertices)
            )
            return Action('build_settlement', best_v)

        # 4. Route : ouvre vers un bon spot ou connecte
        possible_roads = board.get_possible_roads(pid)
        if player.can_build_road() and possible_roads:
            best_edge = max(
                possible_roads,
                key=lambda e: self._road_value(board, e, pid),
                default=random.choice(possible_roads)
            )
            return Action('build_road', best_edge)

        return Action('pass')

    def _choose_robber_move(self, game, pid):
        """Choix stratégique du déplacement du voleur"""
        board = game.board
        best_hex = None
        best_score = -1

        for hex_pos in board.get_all_hexes():
            adj = board.get_adjacent_players(hex_pos)
            opponents = [p for p, _ in adj if p != pid]
            if not opponents:
                continue

            score = len(opponents) * 15  # fort bonus pour plusieurs victimes

            for opp_pid, _ in adj:
                opp = game.players[opp_pid]
                # Pénalise les joueurs déjà en avance
                score += opp.victory_points * 3
                score += sum(opp.resources.values()) // 2
                # Bonus si beaucoup de bâtiments adjacents
                adj_buildings = sum(1 for v, (p, _) in board.buildings.items() 
                                  if p == opp_pid and v in get_corners(*hex_pos))
                score += adj_buildings * 4

            if score > best_score:
                best_score = score
                best_hex = hex_pos

        if best_hex:
            return Action('move_robber', best_hex)

        # Fallback : hex avec le plus d'opposants
        hexes_with_opp = [
            h for h in board.get_all_hexes()
            if any(p != pid for p, _ in board.get_adjacent_players(h))
        ]
        if hexes_with_opp:
            return Action('move_robber', random.choice(hexes_with_opp))
        
        return Action('move_robber', random.choice(board.get_all_hexes()))

    def _vertex_value(self, board, vertex):
        """Valeur heuristique d'un vertex (potentiel de production)"""
        score = 0.0
        adjacent_hexes = 0

        for hex_pos, tile in board.hexes.items():
            if vertex in get_corners(*hex_pos):
                if tile.number:
                    # Valeurs classiques Catan
                    val_map = {5: 2.0, 6: 2.0, 8: 2.0, 9: 2.0,
                               4: 1.2, 10: 1.2,
                               3: 0.6, 11: 0.6,
                               2: 0.2, 12: 0.2}
                    score += val_map.get(tile.number, 0.0)
                    adjacent_hexes += 1

        # Bonus diversité + nombre d'hex
        score += adjacent_hexes * 0.8
        return score

    def _road_value(self, board, edge, player_id):
        """Valeur d'une route : ouvre-t-elle un bon spot ? Connecte-t-elle ?"""
        v1, v2 = list(edge)
        score = 0.0

        for v in (v1, v2):
            # Bonus si connecte à nos bâtiments
            if v in board.buildings and board.buildings[v][0] == player_id:
                score += 3.0

            # Potentiel des vertices voisins libres
            free_neighbors = [
                nv for nv in board.vertex_neighbors[v]
                if nv not in board.buildings
            ]
            for nv in free_neighbors:
                score += self._vertex_value(board, nv) * 0.9

            # Petit bonus si la route bloque un adversaire
            # (simplifié : si le vertex voisin a des bâtiments adverses proches)
            for nv in board.vertex_neighbors[v]:
                if nv in board.buildings and board.buildings[nv][0] != player_id:
                    score += 0.5

        return score

    def choose_trade(self, game, pid):
        """Trade banque : conservateur et opportuniste"""
        player = game.players[pid]
        ports = game.board.get_player_ports(pid)

        total = sum(player.resources.values())
        if total < 6:  # on garde plus de marge que random
            return None

        # Ressource la plus abondante
        abundant = max(player.resources, key=player.resources.get)
        if player.resources[abundant] < 5:
            return None

        # Ce dont on a vraiment besoin (priorité construction)
        need_priority = {
            'brick': 4,   # route + village
            'wood':  4,
            'wheat': 3,   # ville + village
            'sheep': 2,
            'ore':   2
        }

        candidates = []
        for r in RESOURCES:
            if r == abundant:
                continue
            current = player.resources[r]
            if current <= need_priority.get(r, 1):
                candidates.append((r, need_priority.get(r, 1) - current + 1))

        if not candidates:
            return None

        # On choisit la ressource la plus "urgente"
        want, _ = max(candidates, key=lambda x: x[1])

        ratio = player.can_trade_to_bank(abundant, want, ports)
        if ratio is None or ratio > 3:  # on refuse presque toujours le 4:1
            return None

        # On trade seulement si on a vraiment la marge
        if player.resources[abundant] >= ratio + 3:
            return Action(
                action='trade_bank',
                target={
                    'give': abundant,
                    'give_amount': ratio,
                    'receive': want,
                    'receive_amount': 1
                }
            )
        return None

    def choose_player_trade(self, game, pid):
        """Propose un trade joueur seulement si très avantageux pour nous"""
        player = game.players[pid]

        if sum(player.resources.values()) < 5:
            return None

        abundant = max(player.resources, key=player.resources.get)
        if player.resources[abundant] < 5:
            return None

        best_offer = None
        best_advantage = 0

        for other in [p for i, p in enumerate(game.players) if i != pid]:
            advantage = 0
            for r in RESOURCES:
                # On donne ce qu'on a trop, on prend ce qu'on manque
                if player.resources[r] >= 4 and other.resources[r] <= 1:
                    advantage += (player.resources[r] - 2) * 2
                if player.resources[r] <= 1 and other.resources[r] >= 3:
                    advantage += other.resources[r] - 1

            if advantage > best_advantage:
                best_advantage = advantage
                best_offer = other

        if best_advantage < 6:  # seuil élevé pour ne pas proposer n'importe quoi
            return None

        give_res = abundant
        receive_res = min(
            RESOURCES,
            key=lambda r: player.resources[r]  # ce qu'on a le moins
        )

        give_amount = min(3, player.resources[give_res] // 2)
        receive_amount = 1

        # On peut sur-offrir légèrement si besoin
        if player.resources[receive_res] == 0:
            give_amount += 1

        return Action(
            action='trade_player_offer',
            target={
                'target_pid': best_offer.pid,
                'give_res': give_res,
                'give_amount': give_amount,
                'receive_res': receive_res,
                'receive_amount': receive_amount
            }
        )